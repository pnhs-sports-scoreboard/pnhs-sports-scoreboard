
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PNHS Intramurals Scoreboard</title>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f1f3f8;
  color:#17233d;
}
header{
  background:#101d3b;
  color:white;
  text-align:center;
  padding:24px 12px;
}
header h1{margin:0;font-size:24px}
header p{color:#e8c66b;margin-bottom:0}
.container{max-width:1000px;margin:auto;padding:15px}
.panel,.team-card{
  background:white;
  padding:18px;
  border-radius:12px;
  margin-bottom:18px;
  box-shadow:0 2px 9px #00000012;
}
input{
  width:100%;
  padding:11px;
  margin:5px 0;
  border:1px solid #ccd2df;
  border-radius:7px;
  font-size:15px;
}
button{
  padding:10px 13px;
  margin:4px 2px;
  border:0;
  border-radius:7px;
  background:#172b52;
  color:white;
  cursor:pointer;
}
button:hover{opacity:.85}
.gold{background:#b58a27}
.red{background:#ad303b}
.green{background:#267447}
.form-row{display:flex;gap:8px;flex-wrap:wrap}
.form-row input{flex:1;min-width:160px}
#login{
  max-width:400px;
  margin:60px auto;
  padding:22px;
}
#login button{width:100%}
#login h2{text-align:center}
#error{color:#b02a37;font-size:14px}
#app{display:none}
#status{font-size:13px;color:#267447}
table{width:100%;border-collapse:collapse;margin-top:12px}
th,td{
  border:1px solid #dce1e9;
  padding:9px;
  text-align:left;
}
th{background:#172b52;color:white}
.total{background:#fff2cc;font-weight:bold}
.score-input{width:85px}
.team-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
}
.team-heading h2{font-size:20px}
.small{font-size:13px;color:#667085}
@media(max-width:600px){
  header h1{font-size:20px}
  th,td{font-size:12px;padding:7px}
  .score-input{width:65px}
}
</style>
</head>

<body>

<header>
  <h1>PNHS DIGITAL INTRAMURALS SCOREBOARD</h1>
  <p>Sports Score Monitoring System</p>
</header>

<!-- LOGIN -->
<div id="login" class="panel">
  <h2>Scoreboard Login</h2>
  <p class="small">Enter your authorized email and password.</p>

  <input id="email" type="email" placeholder="Email address">
  <input id="password" type="password" placeholder="Password">

  <button id="loginBtn">LOGIN</button>
  <p id="error"></p>
</div>

<!-- SCOREBOARD -->
<div id="app">
<div class="container">

  <div class="panel">
    <strong>Logged in:</strong>
    <span id="account"></span>
    <button id="logoutBtn" class="red">Logout</button>
    <p id="status">Connecting...</p>
    <p class="small">Scoreboard updates automatically on connected phones.</p>
  </div>

  <div class="panel">
    <h2>Add Team</h2>
    <div class="form-row">
      <input id="teamName" placeholder="Enter team name">
      <button id="addTeamBtn">Add Team</button>
    </div>
  </div>

  <div class="panel">
    <h2>Add Sport</h2>
    <div class="form-row">
      <input id="sportName" placeholder="Enter sport name">
      <button id="addSportBtn">Add Sport</button>
    </div>
  </div>

  <div class="panel">
    <h2>Overall Team Rankings</h2>
    <table>
      <thead>
        <tr>
          <th>Rank</th>
          <th>Team</th>
          <th>Total Points</th>
        </tr>
      </thead>
      <tbody id="leaderboard"></tbody>
    </table>
  </div>

  <div id="teams"></div>

</div>
</div>

<script>

// ======================================
// FIREBASE CONFIGURATION
// Replace these with your own Firebase
// web app configuration.
// ======================================

const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_AUTH_DOMAIN",
  databaseURL: "YOUR_DATABASE_URL",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_STORAGE_BUCKET",
  messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
  appId: "YOUR_APP_ID"
};

firebase.initializeApp(firebaseConfig);

const auth = firebase.auth();
const database = firebase.database();

const root = database.ref("intramsScoreboard");

let teams = {};
let sports = {};
let scores = {};

let listeners = [];

// ======================================
// LOGIN
// ======================================

document.getElementById("loginBtn").onclick = function(){

  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;

  document.getElementById("error").textContent = "";

  if(!email || !password){
    document.getElementById("error").textContent =
      "Please enter your email and password.";
    return;
  }

  auth.signInWithEmailAndPassword(email,password)
    .catch(error=>{
      document.getElementById("error").textContent =
        "Login failed: " + error.message;
    });
};

document.getElementById("logoutBtn").onclick = ()=>{
  auth.signOut();
};

// ======================================
// CHECK LOGIN STATUS
// ======================================

auth.onAuthStateChanged(user=>{

  if(user){

    document.getElementById("login").style.display="none";
    document.getElementById("app").style.display="block";
    document.getElementById("account").textContent=user.email;

    startDatabase();

  }else{

    stopDatabase();

    document.getElementById("login").style.display="block";
    document.getElementById("app").style.display="none";
    document.getElementById("account").textContent="";

  }

});

// ======================================
// DATABASE CONNECTION
// ======================================

function startDatabase(){

  stopDatabase();

  const refs = [
    [root.child("teams"), snap=>{
      teams=snap.val() || {};
      render();
    }],
    [root.child("sports"), snap=>{
      sports=snap.val() || {};
      render();
    }],
    [root.child("scores"), snap=>{
      scores=snap.val() || {};
      render();
    }]
  ];

  refs.forEach(([ref,callback])=>{
    ref.on("value",callback);
    listeners.push([ref,callback]);
  });

  root.child("sports").once("value").then(snap=>{

    if(!snap.exists() && auth.currentUser){

      const defaults = {
        sport1:"Basketball Boys",
        sport2:"Basketball Girls",
        sport3:"Volleyball Boys",
        sport4:"Volleyball Girls"
      };

      root.child("sports").set(defaults);

    }

  });

  document.getElementById("status").textContent =
    "Connected - Live updates enabled.";

}

function stopDatabase(){

  listeners.forEach(([ref,callback])=>{
    ref.off("value",callback);
  });

  listeners=[];

}

// ======================================
// ADD TEAM
// ======================================

document.getElementById("addTeamBtn").onclick = ()=>{

  const name=document.getElementById("teamName").value.trim();

  if(!name){
    alert("Enter a team name.");
    return;
  }

  const id=root.child("teams").push().key;

  root.child("teams/"+id).set({name:name})
    .then(()=>{
      document.getElementById("teamName").value="";
    })
    .catch(showError);

};

// ======================================
// ADD SPORT
// ======================================

document.getElementById("addSportBtn").onclick = ()=>{

  const name=document.getElementById("sportName").value.trim();

  if(!name){
    alert("Enter a sport name.");
    return;
  }

  const duplicate=Object.values(sports).some(
    sport=>sport.name.toLowerCase()===name.toLowerCase()
  );

  if(duplicate){
    alert("This sport already exists.");
    return;
  }

  const id=root.child("sports").push().key;

  root.child("sports/"+id).set({name:name})
    .then(()=>{
      document.getElementById("sportName").value="";
    })
    .catch(showError);

};

// ======================================
// RENAME TEAM
// ======================================

function renameTeam(id){

  const oldName=teams[id]?.name || "";
  const name=prompt("Enter new team name:",oldName);

  if(name===null || !name.trim()) return;

  root.child("teams/"+id+"/name")
    .set(name.trim())
    .catch(showError);

}

// ======================================
// DELETE TEAM
// ======================================

function deleteTeam(id){

  if(!confirm("Delete this team and its scores?")) return;

  const updates={};

  updates["teams/"+id]=null;
  updates["scores/"+id]=null;

  root.update(updates).catch(showError);

}

// ======================================
// RENAME SPORT
// ======================================

function renameSport(id){

  const oldName=sports[id].name;
  const name=prompt("Enter new sport name:",oldName);

  if(name===null || !name.trim()) return;

  root.child("sports/"+id+"/name")
    .set(name.trim())
    .catch(showError);

}

// ======================================
// DELETE SPORT
// ======================================

function deleteSport(id){

  const name=sports[id].name;

  if(!confirm("Delete "+name+" and all its scores?")) return;

  const updates={};

  updates["sports/"+id]=null;

  Object.keys(scores).forEach(teamId=>{
    updates["scores/"+teamId+"/"+id]=null;
  });

  root.update(updates).catch(showError);

}

// ======================================
// SAVE SCORE
// ======================================

function saveScore(teamId,sportId,value){

  if(value.trim()===""){
    root.child("scores/"+teamId+"/"+sportId)
      .remove().catch(showError);
    return;
  }

  const number=Number(value);

  if(!Number.isFinite(number) || number<0){
    alert("Enter a valid score of zero or higher.");
    render();
    return;
  }

  root.child("scores/"+teamId+"/"+sportId)
    .set(number)
    .catch(showError);

}

// ======================================
// TOTAL POINTS
// ======================================

function getTotal(teamId){

  let total=0;

  Object.keys(sports).forEach(sportId=>{

    const score=Number(
      scores[teamId]?.[sportId] || 0
    );

    if(Number.isFinite(score)){
      total+=score;
    }

  });

  return total;

}

// ======================================
// DISPLAY SCOREBOARD
// ======================================

function makeButton(label,className,action){

  const button=document.createElement("button");

  button.textContent=label;
  button.className=className;
  button.onclick=action;

  return button;

}

function render(){

  const teamContainer=document.getElementById("teams");
  const leaderboard=document.getElementById("leaderboard");

  teamContainer.innerHTML="";
  leaderboard.innerHTML="";

  const teamList=Object.entries(teams);
  const sportList=Object.entries(sports);

  // TEAM TABLES

  teamList.forEach(([teamId,team])=>{

    const card=document.createElement("div");
    card.className="team-card";

    const heading=document.createElement("div");
    heading.className="team-heading";

    const title=document.createElement("h2");
    title.textContent=team.name;

    const controls=document.createElement("div");

    controls.appendChild(
      makeButton("Rename","gold",()=>renameTeam(teamId))
    );

    controls.appendChild(
      makeButton("Delete","red",()=>deleteTeam(teamId))
    );

    heading.append(title,controls);
    card.appendChild(heading);

    const table=document.createElement("table");

    const thead=document.createElement("thead");
    thead.innerHTML="<tr><th>Sports</th><th>Score</th><th>Manage</th></tr>";

    table.appendChild(thead);

    const tbody=document.createElement("tbody");

    sportList.forEach(([sportId,sport])=>{

      const tr=document.createElement("tr");

      const nameCell=document.createElement("td");
      nameCell.textContent=sport.name;

      const scoreCell=document.createElement("td");

      const input=document.createElement("input");
      input.type="number";
      input.min="0";
      input.step="any";
      input.className="score-input";
      input.placeholder="0";

      const currentScore=scores[teamId]?.[sportId];

      input.value=currentScore ?? "";

      input.onchange=()=>{
        saveScore(teamId,sportId,input.value);
      };

      scoreCell.appendChild(input);

      const manageCell=document.createElement("td");

      manageCell.appendChild(
        makeButton("Edit","gold",()=>renameSport(sportId))
      );

      manageCell.appendChild(
        makeButton("Delete","red",()=>deleteSport(sportId))
      );

      tr.append(nameCell,scoreCell,manageCell);
      tbody.appendChild(tr);

    });

    table.appendChild(tbody);

    const foot=document.createElement("tfoot");
    const totalRow=document.createElement("tr");
    totalRow.className="total";

    const totalLabel=document.createElement("td");
    totalLabel.colSpan=2;
    totalLabel.textContent="TOTAL POINTS";

    const totalValue=document.createElement("td");
    totalValue.textContent=getTotal(teamId);

    totalRow.append(totalLabel,totalValue);
    foot.appendChild(totalRow);
    table.appendChild(foot);

    card.appendChild(table);
    teamContainer.appendChild(card);

  });

  // OVERALL RANKING

  const ranking=teamList.map(([id,team])=>({
    name:team.name,
    total:getTotal(id)
  })).sort((a,b)=>b.total-a.total);

  ranking.forEach((team,index)=>{

    const tr=document.createElement("tr");

    [index+1,team.name,team.total].forEach(value=>{

      const td=document.createElement("td");
      td.textContent=value;
      tr.appendChild(td);

    });

    leaderboard.appendChild(tr);

  });

}

// ======================================
// ERROR MESSAGE
// ======================================

function showError(error){

  alert("Error: "+error.message);

}

</script>

</body>
</html>
